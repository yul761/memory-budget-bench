# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# The LongMemEval dataset (~544MB) is third-party data under its own licence.
# See README for how to fetch it.
data/

# Upstream repositories, cloned for reference and comparison. Each carries its
# own licence and history; vendoring them here would misrepresent authorship.
# See README for the exact revisions used.
mem0-harness/
official-locomo/
official-longmemeval/

# Run artefacts: retrieval payloads, traces, hypotheses. Large, machine-specific,
# and regenerated by re-running. Reports worth keeping are committed by hand.
runs/

# Local secrets, if any ever land here. Every script reads keys from the
# environment; nothing should be written to a file.
.env
.env.*
!.env.example
